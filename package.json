{
  "name": "ANDREW-ULTRAX",
  "version": "2.7.6",
  "description": "WhatsApp Bot",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "start:optimized": "node --max-old-space-size=512 index.js",
    "cleanup": "node cleanup.js",
    "reset-session": "node reset-session.js",
    "start:clean": "npm run cleanup && npm run start:optimized",
    "start:fresh": "npm run reset-session -- --yes && npm start",
    "install:force": "npm install --force",
    "test": "echo \"Error: no test specified\" && exit 1",
    "docker:build": "docker build -t andrew-ultrax .",
    "docker:run": "docker run --rm -e SESSION_ID=\"$SESSION_ID\" -e OWNER_NUMBER=\"$OWNER_NUMBER\" andrew-ultrax",
    "install:panel": "npm install --legacy-peer-deps"
  },
  "keywords": [
    "whatsapp-bot"
  ],
  "author": "Andrew-X",
  "license": "ISC",
  "dependencies": {
    "@adiwajshing/keyed-db": "^0.2.4",
    "@hapi/boom": "^10.0.1",
    "@whiskeysockets/baileys": "^v7.0.0-rc.9",
    "awesome-phonenumber": "^5.9.0",
    "axios": "^1.8.4",
    "chalk": "^4.1.2",
    "cheerio": "^1.0.0-rc.12",
    "dotenv": "*",
    "express": "^4.19.2",
    "ffmpeg-static": "^5.3.0",
    "file-type": "^16.5.4",
    "fluent-ffmpeg": "^2.1.3",
    "form-data": "^4.0.1",
    "fs-extra": "^11.2.0",
    "g-i-s": "^2.1.7",
    "gtts": "^0.2.1",
    "human-readable": "^0.2.1",
    "jimp": "^1.6.0",
    "js-confuser": "^1.0.9",
    "lolcatjs": "^2.4.3",
    "moment-timezone": "^0.5.43",
    "mumaker": "^2.0.0",
    "node-cache": "^5.1.2",
    "node-fetch": "^2.7.0",
    "node-id3": "^0.2.3",
    "node-webpmux": "^3.1.0",
    "node-youtube-music": "^0.8.3",
    "pino": "^8.21.0",
    "pm2": "^5.3.1",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "ruhend-scraper": "^8.3.0",
    "sharp": "^0.34.5",
    "webp-converter": "latest",
    "ws": "^8.17.1",
    "youtube-yts": "^2.0.0",
    "youtubedl-core": "^4.11.7",
    "yt-search": "^2.12.1",
    "ytdl-core": "^4.11.5"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0"
  }
}
